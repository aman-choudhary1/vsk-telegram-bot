# ── Telegram ──
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ── Database (must be the SAME database the backend uses) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ── Morning briefing (sent by the backend; /briefing asks the backend) ──
BACKEND_URL=http://localhost:5000
# Same long random value as TELEGRAM_INTERNAL_TOKEN in the backend .env
TELEGRAM_INTERNAL_TOKEN=

# ── Legacy fixed-threshold alert (off by default; the briefing replaces it) ──
# ALERT_LEGACY=on
ALERT_THRESHOLD=75
ALERT_CRON=30 10 * * 1-6
ALERT_CHAT_IDS=
